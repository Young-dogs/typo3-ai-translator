{
    "name": "young-dogs/typo3-ai-translator",
    "description": "Young Dogs AI Translation service integration for TYPO3",
    "version": "1.0.0.",
    "license": "MIT",
    "type": "typo3-cms-extension",
    "keywords"": [
        "typo3",
        "extension",
        "translation",
        "ai"
    ],
    "authors": [
        {
            "name": "Young-dogs",
            "homepage": "https://www.young-dogs.com"
        }
    ],
    "require": {
        "typo3/cms-core": "^14",
        "typo3/cms-backend": "^14"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "youngdogs_translate"
        }
    },
    "autoload": {
        "psr-4": {
            "YoungDogs\\Translate\\": "Classes/"
        }
    }
}
